# Secrets -- .env holds a live NVIDIA API key.
.env

# Environments
venv/
.venv/

# Model weights and checkpoints (255 MB; also over GitHub's 100 MB file limit)
models/
training-checkpoints/
*.zip

# Runtime artefacts
__pycache__/
*.pyc
logs/
uploads/
.cache/

# ---------------------------------------------------------------------------
# Personal data. Any real CV dropped into data/ stays local: the UI screenshots
# render the resume's contact block -- name, phone, email, city -- in full, so
# driving the demo with a real document would publish someone's personal data
# irreversibly. That is the exact thing the app's own PII handling exists to
# prevent, so the repository should not contradict it.
#
# data/sample_resume.pdf is the exception and is committed deliberately: it is
# generated by scripts/make_sample_resume.py and entirely invented, which is
# what makes docs/screenshots/ publishable.
data/*.pdf
!data/sample_resume.pdf
data/*.png
data/*.jpg
data/*.jpeg

# The submitted document carries the student's name and ID; REPORT.md does not.
REPORT.docx

# Same rule for the video: docs/demo.mp4 is committed and carries no personal
# details, while the titled cut prepends a card with the name and BITS ID.
# Rebuild it locally with scripts/add_title_card.py.
docs/demo_titled.mp4

# The --only clips carry no title cards, so their cue sheets are a single
# "(end)" line. The full walkthrough's docs/demo_timeline.txt is kept.
docs/demo_swagger_timeline.txt
docs/demo_llmops_timeline.txt

# Word lock files
~$*

# Voice-over takes and their output (local only -- your own voice).
docs/*_vo.mp4
docs/*_vo.wav
