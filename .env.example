# Copy to .env and fill in. Get a free key at https://build.nvidia.com/models
# Never put a real key in THIS file — .env.example is committed, .env is not.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_TIMEOUT_SEC=60

# Optional overrides
MAX_UPLOAD_MB=10
FINETUNED_DIR=models/finetuned-fit-classifier

# Load the models at startup instead of on first request. Set to 1 for a demo
# so the first call is not the slow one; leave 0 with uvicorn --reload.
WARMUP_MODELS=0

# gpt-oss-20b reasoning budget. "low" halved completion tokens (820 -> 393) with
# no visible quality loss and cut /candidate-brief latency substantially.
# Set to "" to send nothing.
LLM_REASONING_EFFORT=low
